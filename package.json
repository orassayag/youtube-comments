{
  "name": "youtube-comments",
  "version": "1.0.0",
  "private": false,
  "description": "A Node.js application to fetch & log all comments from a specific video using the YouTube Data API v3. This application provides a simple way to extract all comments from any public YouTube video and save them to a TXT file for analysis, archival, or research purposes, include pagination support",
  "keywords": [
    "youtube",
    "comments",
    "youtube-api",
    "youtube-data-api",
    "video-comments",
    "comment-scraper",
    "youtube-v3",
    "api-client",
    "comment-extraction",
    "nodejs"
  ],
  "homepage": "https://github.com/orassayag/youtube-comments#readme",
  "bugs": {
    "url": "https://github.com/orassayag/youtube-comments/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/orassayag/youtube-comments.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/orassayag"
  },
  "license": "MIT",
  "author": {
    "name": "Or Assayag",
    "email": "orassayag@gmail.com",
    "url": "https://github.com/orassayag"
  },
  "contributors": [
    {
      "name": "Or Assayag",
      "email": "orassayag@gmail.com",
      "url": "https://github.com/orassayag"
    }
  ],
  "type": "module",
  "main": "src/index.js",
  "files": [
    ".github",
    ".vscode",
    "dist",
    "misc",
    "src",
    ".eslintignore",
    ".eslintrc",
    ".gitignore",
    ".jsbeautifyrc",
    ".npmignore",
    ".prettierrc",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "eslint.config.mjs",
    "INSTRUCTIONS.md",
    "LICENSE",
    "package-lock.json",
    "package.json",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "backup": "node --es-module-specifier-resolution=node src/scripts/backup.script.js",
    "sand": "node --es-module-specifier-resolution=node src/tests/sandbox.test.js",
    "start": "node --es-module-specifier-resolution=node src/scripts/comments.script.js",
    "stop": "taskkill -f -im node.exe"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "axios": "^1.13.6",
    "fs-extra": "^11.3.4",
    "is-reachable": "^6.1.0"
  },
  "devDependencies": {
    "eslint": "^10.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
